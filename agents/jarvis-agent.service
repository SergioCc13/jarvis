# Jarvis device agent — systemd service for Linux devices (PC, etc.).
#
# Install:
#   # 1. Copy and fill in agents/.env first:
#   #    cp agents/env.example agents/.env && nano agents/.env
#   #
#   # 2. Edit this file if your user or jarvis path differ (default: /home/pi/jarvis).
#   #
#   # 3. Install:
#   sudo cp agents/jarvis-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jarvis-agent
#
# Logs:
#   journalctl -u jarvis-agent -f

[Unit]
Description=Jarvis Device Agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jarvis
EnvironmentFile=/home/pi/jarvis/agents/.env
ExecStart=/usr/bin/python3 agents/device_agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
