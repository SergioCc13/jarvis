# Copy this to agents/.env and source it before starting the agent:
#   source agents/.env && python3 agents/device_agent.py

# Pi hub Tailscale IP and port
export JARVIS_HUB_URL=http://<pi-tailscale-ip>:8792

# Bridge token — copy from bridge/config.json on the Pi (the "token" field).
# Required so the agent can authenticate when registering with the hub.
export JARVIS_HUB_TOKEN=<bridge-token>

# Name this device (change per device: mac-sergio, pc-sergio, etc.)
export JARVIS_DEVICE_NAME=mac-sergio

# Port the agent listens on (default 8793 — change if conflict)
export JARVIS_AGENT_PORT=8793

# ── Shell action PIN (opcional pero recomendado) ──────────────────────────────
# A second secret, separate from JARVIS_HUB_TOKEN, required specifically for
# action:"shell" (full remote code execution). Pick your own PIN — same value
# on every device where you want it enforced. Blank = shell works with just
# the token, like before.
export JARVIS_AGENT_SHELL_PIN=

# Recovery: GET /pin-recover (token-authenticated) emails the current PIN to
# JARVIS_EMAIL_TO. Reuses the same var names as bridge/.env.example — copy
# those values here too if you want recovery to work from this device.
export JARVIS_EMAIL_FROM=
export JARVIS_EMAIL_PASSWORD=
export JARVIS_EMAIL_TO=
export JARVIS_EMAIL_SMTP=smtp.gmail.com
export JARVIS_EMAIL_PORT=587

# ── Cardmarket MKM API (see agents/cardmarket.env.example for instructions) ──
export MKM_APP_TOKEN=
export MKM_APP_SECRET=
export MKM_ACCESS_TOKEN=
export MKM_ACCESS_SECRET=

# ── SerpAPI (Google search) — optional, 100 free searches/month ──────
# Get key at https://serpapi.com (free plan)
export SERPAPI_KEY=
