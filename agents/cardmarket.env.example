# Cardmarket MKM API credentials — add these to agents/.env
#
# Cómo obtenerlas:
# 1. Ve a https://www.cardmarket.com/en/Magic/Account/API
# 2. Crea una app (Developer Tools → Create App)
# 3. Copia App Token y App Secret
# 4. Genera Access Token y Access Secret en la misma página

MKM_APP_TOKEN=
MKM_APP_SECRET=
MKM_ACCESS_TOKEN=
MKM_ACCESS_SECRET=
