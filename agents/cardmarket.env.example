# Cardmarket MKM API credentials — add these to agents/.env
#
# How to get them:
# 1. Go to https://www.cardmarket.com/en/Magic/Account/API
# 2. Create an app (Developer Tools → Create App)
# 3. Copy App Token and App Secret
# 4. Generate Access Token and Access Secret on the same page

MKM_APP_TOKEN=
MKM_APP_SECRET=
MKM_ACCESS_TOKEN=
MKM_ACCESS_SECRET=
