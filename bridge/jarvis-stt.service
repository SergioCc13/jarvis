[Unit]
Description=Jarvis STT server (Whisper)
After=network.target

[Service]
WorkingDirectory=/home/pi/jarvis
Environment=VOICEMODE_WHISPER_LANGUAGE=es
Environment=WHISPER_MODEL=tiny
ExecStart=/usr/bin/python3 /home/pi/jarvis/agents/stt_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
