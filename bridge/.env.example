# Jarvis notification channels — copy this to bridge/.env and fill in your values.
# bridge/.env is gitignored and never committed.

# ── CORS (opcional) ──────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this bridge from browser JS, e.g.
# https://raspberrypi.tailfe7913.ts.net,https://perseo.tailfe7913.ts.net
# Left blank: falls back to reflecting the request's own Origin only if it
# ends in .ts.net (Tailscale MagicDNS) — never a blanket "*".
JARVIS_ALLOWED_ORIGINS=

# ── Discord (opcional) ─────────────────────────────────────────────────────────
# Create a webhook in Discord: channel Settings → Integrations → Webhooks → New
JARVIS_DISCORD_WEBHOOK=

# ── Telegram ───────────────────────────────────────────────────────────────────
# 1. Create a bot: talk to @BotFather, /newbot
# 2. Get your chat ID: send a message to the bot, then:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
JARVIS_TELEGRAM_TOKEN=
JARVIS_TELEGRAM_CHAT_ID=

# ── Voice backends (STT + TTS fallback chain) ─────────────────────────────────
# Comma-separated Tailscale IPs of devices running Whisper (port 2022) and
# Kokoro/Piper (port 8880), in priority order. Pi's own services are last fallback.
# Requires voicemode running on those devices and bound to 0.0.0.0 (not 127.0.0.1).
# Leave blank to always use Pi's local services.
JARVIS_VOICE_BACKENDS=

# ── Fallback escalonado cuando Claude falla o se queda sin tokens ─────────────
# Orden: Claude → nube gratis → Ollama remoto (grande) → Ollama local (pequeño).

# Tier 1 — nube gratis (OpenAI-compatible: Groq, Gemini, OpenRouter…). Opcional:
# deja JARVIS_CLOUD_URL en blanco para saltar directo a Ollama.
# El catálogo de modelos gratis cambia con frecuencia — antes de fijar uno,
# comprueba cuáles están disponibles con tu key: GET <base>/v1/models.
#   Groq:   https://api.groq.com/openai/v1/chat/completions   modelo openai/gpt-oss-120b
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions  modelo gemini-2.0-flash
JARVIS_CLOUD_URL=
JARVIS_CLOUD_KEY=
JARVIS_CLOUD_MODEL=

# Tier 2/3 — Ollama.
# Mac: LaunchAgent en Library/LaunchAgents/com.jarvis.ollama.plist arranca automático
#      ollama pull qwen2.5:7b  (necesita ~4GB RAM)
# Pi:  bin/install-pi instala Ollama + qwen2.5:3b automáticamente
#
# Backends separados por coma, en orden de prioridad. Cada entrada es IP o
# IP=modelo, así una máquina de 32GB corre un tag más grande que una de 8GB.
# Las IP sin "=modelo" usan JARVIS_OLLAMA_MODEL (o _MODEL_LOCAL para 127.0.0.1).
# Incluye 127.0.0.1 al final para que la Pi use su propio Ollama como último recurso.
# Ojo con la RAM del dispositivo, no solo la del modelo (deja margen para el SO
# y lo demás que corra ahí): qwen2.5:3b ~2GB, qwen2.5:7b ~4-5GB, qwen2.5-coder:32b
# ~20GB+ — ese último tag solo tiene sentido en una máquina con 32GB+ de RAM.
JARVIS_OLLAMA_BACKENDS=100.70.136.73=qwen2.5:3b,127.0.0.1=qwen2.5:3b
JARVIS_OLLAMA_MODEL=qwen2.5:7b
JARVIS_OLLAMA_MODEL_LOCAL=qwen2.5:3b
# Ollama remoto: arráncalo con OLLAMA_HOST=0.0.0.0 o no escucha por Tailscale.
# El modelo TIENE que estar descargado en cada backend (ollama pull qwen2.5:7b);
# si falta, el bridge usa cualquier otro modelo instalado en ese backend.
# Segundos de espera de la 1ª respuesta (carga del modelo en RAM) y cuánto la mantiene viva.
JARVIS_OLLAMA_TIMEOUT=300
JARVIS_OLLAMA_KEEP_ALIVE=30m

# ── Kokoro TTS (opcional) ──────────────────────────────────────────────────────
# Leave blank to use the default (http://127.0.0.1:8880/v1/audio/speech)
# VOICEMODE_TTS_URL=http://127.0.0.1:8880/v1/audio/speech
# JARVIS_TTS_VOICE=af_sky

# ── Telegram bot replies ───────────────────────────────────────────────────────
# Set to 0 to force text-only replies (skip Kokoro voice synthesis)
# JARVIS_TG_VOICE=1

# ── Email (Gmail App Password) ─────────────────────────────────────────────────
# How to get an App Password:
#   myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de app
#   Crea una nueva llamada "Jarvis". Copia las 16 letras (con o sin espacios).
JARVIS_EMAIL_FROM=tu@gmail.com
JARVIS_EMAIL_TO=tu@gmail.com
JARVIS_EMAIL_SMTP=smtp.gmail.com
JARVIS_EMAIL_PORT=587
JARVIS_EMAIL_PASSWORD=
