# Jarvis notification channels — copy this to bridge/.env and fill in your values.
# bridge/.env is gitignored and never committed.

# ── Discord (opcional) ─────────────────────────────────────────────────────────
# Create a webhook in Discord: channel Settings → Integrations → Webhooks → New
JARVIS_DISCORD_WEBHOOK=

# ── Telegram ───────────────────────────────────────────────────────────────────
# 1. Create a bot: talk to @BotFather, /newbot
# 2. Get your chat ID: send a message to the bot, then:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
JARVIS_TELEGRAM_TOKEN=
JARVIS_TELEGRAM_CHAT_ID=

# ── Voice backends (STT + TTS fallback chain) ─────────────────────────────────
# Comma-separated Tailscale IPs of devices running Whisper (port 2022) and
# Kokoro/Piper (port 8880), in priority order. Pi's own services are last fallback.
# Requires voicemode running on those devices and bound to 0.0.0.0 (not 127.0.0.1).
# Leave blank to always use Pi's local services.
JARVIS_VOICE_BACKENDS=

# ── Ollama fallback (LLM offline cuando Claude falla o se queda sin tokens) ────
# Mac: LaunchAgent en Library/LaunchAgents/com.jarvis.ollama.plist arranca automático
#      ollama pull qwen2.5:7b  (necesita ~4GB RAM)
# Pi:  bin/install-pi instala Ollama + qwen2.5:3b automáticamente
#
# Backends separados por coma, en orden de prioridad.
# Incluye 127.0.0.1 al final para que la Pi use su propio Ollama como último recurso.
JARVIS_OLLAMA_BACKENDS=100.70.136.73,127.0.0.1
JARVIS_OLLAMA_MODEL=qwen2.5:7b
JARVIS_OLLAMA_MODEL_LOCAL=qwen2.5:3b

# ── Kokoro TTS (opcional) ──────────────────────────────────────────────────────
# Leave blank to use the default (http://127.0.0.1:8880/v1/audio/speech)
# VOICEMODE_TTS_URL=http://127.0.0.1:8880/v1/audio/speech
# JARVIS_TTS_VOICE=af_sky

# ── Telegram bot replies ───────────────────────────────────────────────────────
# Set to 0 to force text-only replies (skip Kokoro voice synthesis)
# JARVIS_TG_VOICE=1

# ── Email (Gmail App Password) ─────────────────────────────────────────────────
# How to get an App Password:
#   myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de app
#   Crea una nueva llamada "Jarvis". Copia las 16 letras (con o sin espacios).
JARVIS_EMAIL_FROM=tu@gmail.com
JARVIS_EMAIL_TO=tu@gmail.com
JARVIS_EMAIL_SMTP=smtp.gmail.com
JARVIS_EMAIL_PORT=587
JARVIS_EMAIL_PASSWORD=
