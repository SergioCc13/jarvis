# Jarvis notification channels — copy this to bridge/.env and fill in your values.
# bridge/.env is gitignored and never committed.

# ── CORS (optional) ──────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this bridge from browser JS, e.g.
# https://raspberrypi.tailfe7913.ts.net,https://perseo.tailfe7913.ts.net
# Left blank: falls back to reflecting the request's own Origin only if it
# ends in .ts.net (Tailscale MagicDNS) — never a blanket "*".
JARVIS_ALLOWED_ORIGINS=

# ── Discord (optional) ─────────────────────────────────────────────────────────
# Create a webhook in Discord: channel Settings → Integrations → Webhooks → New
JARVIS_DISCORD_WEBHOOK=

# ── Telegram ───────────────────────────────────────────────────────────────────
# 1. Create a bot: talk to @BotFather, /newbot
# 2. Get your chat ID: send a message to the bot, then:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
JARVIS_TELEGRAM_TOKEN=
JARVIS_TELEGRAM_CHAT_ID=

# ── Voice backends (STT + TTS fallback chain) ─────────────────────────────────
# Comma-separated Tailscale IPs of devices running Whisper (port 2022) and
# Kokoro/Piper (port 8880), in priority order. Pi's own services are last fallback.
# Requires voicemode running on those devices and bound to 0.0.0.0 (not 127.0.0.1).
# Leave blank to always use Pi's local services.
JARVIS_VOICE_BACKENDS=

# ── Tiered fallback when Claude fails or runs out of tokens ───────────────────
# Order: Claude → free cloud → remote Ollama (large) → local Ollama (small).

# Tier 1 — free cloud (OpenAI-compatible: Groq, Gemini, OpenRouter…). Optional:
# leave JARVIS_CLOUD_URL blank to skip straight to Ollama.
# The free-model catalogue changes often — before pinning one, check which are
# available with your key: GET <base>/v1/models.
#   Groq:   https://api.groq.com/openai/v1/chat/completions   model openai/gpt-oss-120b
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions  model gemini-2.0-flash
JARVIS_CLOUD_URL=
JARVIS_CLOUD_KEY=
JARVIS_CLOUD_MODEL=

# Tier 2/3 — Ollama.
# Mac: a LaunchAgent at Library/LaunchAgents/com.jarvis.ollama.plist starts it automatically
#      ollama pull qwen2.5:7b  (needs ~4GB RAM)
# Pi:  bin/install-pi installs Ollama + qwen2.5:3b automatically
#
# Comma-separated backends, in priority order. Each entry is IP or IP=model, so a
# 32GB machine runs a larger tag than an 8GB one.
# IPs without "=model" use JARVIS_OLLAMA_MODEL (or _MODEL_LOCAL for 127.0.0.1).
# Put 127.0.0.1 last so the Pi uses its own Ollama as the last resort.
# Watch the device's RAM, not just the model's (leave headroom for the OS and
# whatever else runs there): qwen2.5:3b ~2GB, qwen2.5:7b ~4-5GB, qwen2.5-coder:32b
# ~20GB+ — that last tag only makes sense on a machine with 32GB+ of RAM.
JARVIS_OLLAMA_BACKENDS=100.70.136.73=qwen2.5:3b,127.0.0.1=qwen2.5:3b
JARVIS_OLLAMA_MODEL=qwen2.5:7b
JARVIS_OLLAMA_MODEL_LOCAL=qwen2.5:3b
# Remote Ollama: start it with OLLAMA_HOST=0.0.0.0 or it won't listen over Tailscale.
# The model MUST be pulled on each backend (ollama pull qwen2.5:7b); if it's
# missing, the bridge uses any other model installed on that backend.
# Seconds to wait for the 1st response (loading the model into RAM) and how long to keep it alive.
JARVIS_OLLAMA_TIMEOUT=300
JARVIS_OLLAMA_KEEP_ALIVE=30m

# ── Kokoro TTS (optional) ──────────────────────────────────────────────────────
# Leave blank to use the default (http://127.0.0.1:8880/v1/audio/speech)
# VOICEMODE_TTS_URL=http://127.0.0.1:8880/v1/audio/speech
# JARVIS_TTS_VOICE=af_sky

# ── Telegram bot replies ───────────────────────────────────────────────────────
# Set to 0 to force text-only replies (skip Kokoro voice synthesis)
# JARVIS_TG_VOICE=1

# ── Email (Gmail App Password) ─────────────────────────────────────────────────
# How to get an App Password:
#   myaccount.google.com → Security → 2-Step Verification → App passwords
#   Create a new one called "Jarvis". Copy the 16 letters (with or without spaces).
JARVIS_EMAIL_FROM=you@gmail.com
JARVIS_EMAIL_TO=you@gmail.com
JARVIS_EMAIL_SMTP=smtp.gmail.com
JARVIS_EMAIL_PORT=587
JARVIS_EMAIL_PASSWORD=
