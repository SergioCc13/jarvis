#!/usr/bin/env bash
# Auto-update Jarvis from GitHub. Run via cron (Pi) or LaunchAgent (Mac).
# Detects what changed and only restarts affected services.
set -uo pipefail

JARVIS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$JARVIS_DIR"

# Check network before anything
git fetch origin main -q 2>/dev/null || exit 0

BEFORE=$(git rev-parse HEAD)
AFTER=$(git rev-parse origin/main)

[ "$BEFORE" = "$AFTER" ] && exit 0   # nothing new

# Never discard uncommitted local work — `git reset --hard` here would nuke
# it silently every time another device pushes. Stash it instead and leave
# a note; a human (or Claude) can `git stash pop` and sort out any conflict.
if ! git diff --quiet || ! git diff --cached --quiet; then
  STASH_MSG="auto-update autostash $(date '+%Y-%m-%d %H:%M:%S')"
  git stash push -u -m "$STASH_MSG" -q
  echo "[auto-update] local changes stashed (\"$STASH_MSG\") before updating — run 'git stash list' to recover"
fi

# Also never discard local COMMITS that never made it to origin (e.g. this
# device can't push — no git credentials configured here). A plain
# `git reset --hard origin/main` would silently orphan them. Tag them under
# refs/backup instead so they survive and are easy to find/cherry-pick later.
if ! git merge-base --is-ancestor HEAD origin/main 2>/dev/null; then
  BACKUP_REF="refs/backup/auto-update-$(date '+%Y%m%d-%H%M%S')"
  git update-ref "$BACKUP_REF" HEAD
  echo "[auto-update] local commits not on origin — backed up as $BACKUP_REF (git log $BACKUP_REF to recover, or: git cherry-pick <sha>)"
fi

echo "[auto-update] $(date '+%H:%M:%S') — updating $BEFORE → $AFTER"
git reset --hard origin/main -q

CHANGED=$(git diff --name-only "$BEFORE" "$AFTER" 2>/dev/null || true)

# Restart bridge if server.py or notify.py changed.
# `systemctl restart` with no sudo always failed here even with a NOPASSWD
# sudoers rule in place, because plain `systemctl restart` (no sudo) hits
# polkit's interactive-auth prompt and just hangs/fails in a non-interactive
# cron — it never even tries sudo. Try sudo -n (non-interactive: fails fast,
# no hang, if NOPASSWD isn't set up) first, then fall back to plain.
if echo "$CHANGED" | grep -qE "^bridge/(server|notify)\.py" && command -v systemctl >/dev/null 2>&1; then
  if sudo -n systemctl restart jarvis-bridge 2>/dev/null; then
    echo "[auto-update] jarvis-bridge restarted (sudo)"
  elif systemctl restart jarvis-bridge 2>/dev/null; then
    echo "[auto-update] jarvis-bridge restarted"
  else
    echo "[auto-update] could not restart jarvis-bridge — needs manual restart (see /etc/sudoers.d/jarvis-bridge-restart)"
  fi
fi

# Restart telegram bot if it changed
if echo "$CHANGED" | grep -q "^bridge/telegram_bot.py" && command -v systemctl >/dev/null 2>&1; then
  if sudo -n systemctl restart jarvis-telegram 2>/dev/null; then
    echo "[auto-update] jarvis-telegram restarted (sudo)"
  elif systemctl restart jarvis-telegram 2>/dev/null; then
    echo "[auto-update] jarvis-telegram restarted"
  else
    echo "[auto-update] could not restart jarvis-telegram — needs manual restart"
  fi
fi

# Restart the device agent if it changed. Mac runs it under launchd
# (com.jarvis.device-agent); Linux (Pi, PC-under-WSL) runs it under systemd
# as "jarvis-agent". Each branch only acts if that service actually exists,
# so this is a no-op on devices without the agent installed.
if echo "$CHANGED" | grep -q "^agents/device_agent\.py"; then
  if command -v launchctl >/dev/null 2>&1 && launchctl list 2>/dev/null | grep -q com.jarvis.device-agent; then
    if launchctl kickstart -k "gui/$(id -u)/com.jarvis.device-agent" 2>/dev/null; then
      echo "[auto-update] device_agent restarted (launchd)"
    else
      echo "[auto-update] could not restart device_agent — needs manual restart"
    fi
  elif command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files jarvis-agent.service >/dev/null 2>&1; then
    if sudo -n systemctl restart jarvis-agent 2>/dev/null; then
      echo "[auto-update] jarvis-agent restarted (sudo)"
    elif systemctl restart jarvis-agent 2>/dev/null; then
      echo "[auto-update] jarvis-agent restarted"
    else
      echo "[auto-update] could not restart jarvis-agent — needs manual restart (see /etc/sudoers.d/jarvis-bridge-restart)"
    fi
  fi
fi

# HUD files (html/css/js) are served statically — no restart needed
if echo "$CHANGED" | grep -qE "^hud/"; then
  echo "[auto-update] HUD updated — reload browser to see changes"
fi

echo "[auto-update] done"
