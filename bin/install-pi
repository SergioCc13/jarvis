#!/usr/bin/env bash
# Jarvis Pi installer — run this once on the Raspberry Pi after cloning the repo.
#
# Usage (from the Mac, when Pi is reachable via Tailscale):
#   ssh pi@100.105.221.87 "cd /home/pi/jarvis && git pull && bash bin/install-pi"
#
# Or directly on the Pi:
#   cd /home/pi/jarvis && bash bin/install-pi

set -euo pipefail
JARVIS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$JARVIS_DIR"
PI_USER="${SUDO_USER:-${USER:-pi}}"

echo "=== Jarvis Pi installer ==="
echo "Dir: $JARVIS_DIR"
echo "User: $PI_USER"
echo ""

# ── 1. Pull latest code ───────────────────────────────────────────────
echo "[1/7] Pulling latest code..."
git pull

# ── 2. bridge/.env ───────────────────────────────────────────────────
if [ ! -f bridge/.env ]; then
  echo ""
  echo "[2/7] bridge/.env not found."
  echo "      Copy it from your Mac first:"
  echo "        scp bridge/.env pi@100.105.221.87:$JARVIS_DIR/bridge/.env"
  echo "      Then re-run this script."
  exit 1
else
  echo "[2/7] bridge/.env found ✓"
fi

# matplotlib powers the scores chart attached to the weekly market email;
# without it bin/analiza just skips the chart (non-fatal).
if ! python3 -c "import matplotlib" 2>/dev/null; then
  echo "  Installing python3-matplotlib (for the market scores chart)..."
  sudo apt-get install -y python3-matplotlib 2>/dev/null \
    && echo "  ✓ matplotlib ready" || echo "  ✗ matplotlib not installed — chart will be skipped"
fi

# ── 3. Ollama (local LLM fallback) ────────────────────────────────────
echo "[3/7] Installing Ollama..."

OLLAMA_MODEL_LOCAL="${JARVIS_OLLAMA_MODEL_LOCAL:-qwen2.5:3b}"

if command -v ollama >/dev/null 2>&1; then
  echo "  ✓ ollama already installed ($(ollama --version 2>/dev/null | head -1))"
else
  echo "  Downloading Ollama..."
  curl -fsSL https://ollama.com/install.sh | sh
  echo "  ✓ ollama installed"
fi

# Start ollama service temporarily to pull model
sudo systemctl start ollama 2>/dev/null || true
sleep 3

if ollama list 2>/dev/null | grep -q "${OLLAMA_MODEL_LOCAL%%:*}"; then
  echo "  ✓ $OLLAMA_MODEL_LOCAL already pulled"
else
  echo "  Pulling $OLLAMA_MODEL_LOCAL (may take a few minutes)..."
  ollama pull "$OLLAMA_MODEL_LOCAL" && echo "  ✓ $OLLAMA_MODEL_LOCAL ready" || echo "  ✗ pull failed — run manually: ollama pull $OLLAMA_MODEL_LOCAL"
fi

# Enable ollama system service (installed by install.sh)
sudo systemctl enable --now ollama 2>/dev/null && echo "  ✓ ollama service enabled" || true

# ── 4. systemd services ───────────────────────────────────────────────
echo "[4/7] Installing systemd services..."

for svc in bridge/jarvis-bridge.service bridge/jarvis-telegram.service agents/jarvis-agent.service; do
  name="$(basename "$svc")"
  # Fix User= to match actual user
  sed "s/^User=.*/User=$PI_USER/" "$svc" > /tmp/"$name"
  # Fix WorkingDirectory= to actual path
  sed -i "s|WorkingDirectory=.*|WorkingDirectory=$JARVIS_DIR|" /tmp/"$name"
  # Fix EnvironmentFile= paths
  sed -i "s|EnvironmentFile=.*bridge/.env|EnvironmentFile=$JARVIS_DIR/bridge/.env|" /tmp/"$name"
  sed -i "s|EnvironmentFile=.*agents/.env|EnvironmentFile=$JARVIS_DIR/agents/.env|" /tmp/"$name"
  sudo cp /tmp/"$name" /etc/systemd/system/"$name"
  echo "  ✓ $name installed"
done

sudo systemctl daemon-reload

for svc in jarvis-bridge jarvis-telegram; do
  sudo systemctl enable "$svc"
  sudo systemctl restart "$svc"
  echo "  ✓ $svc enabled and started"
done

# ── 5. crontab ───────────────────────────────────────────────────────
echo "[5/7] Setting up crontab..."

CRON_MARKER="# === Jarvis ==="
CRON_BLOCK="$CRON_MARKER
# Auto-update from GitHub — every 5 min
*/5 * * * * cd $JARVIS_DIR && bash bin/auto-update >> /tmp/jarvis-update.log 2>&1
# Vault refresh — 7:30 AM (before brief)
30 7 * * * cd $JARVIS_DIR && bin/vault-refresh >> /tmp/jarvis-vault.log 2>&1
# Morning brief — 8:00 AM
0 8 * * * cd $JARVIS_DIR && bin/morning-brief >> /tmp/jarvis-brief.log 2>&1
# Market analysis — FULL multi-agent (+ real dates + scores chart), Mondays 6:30 AM (~20-40 min)
30 6 * * 1 cd $JARVIS_DIR && bin/analiza >> /tmp/jarvis-mercado.log 2>&1
# Market analysis — quick 1-call summary, every other day 7:00 AM
0 7 * * 0,2-6 cd $JARVIS_DIR && bin/analiza --rapido >> /tmp/jarvis-mercado.log 2>&1
# Watchlist seguimiento — fast indicator+event heads-up (LLM only on signals), 8:00 AM daily
0 8 * * * cd $JARVIS_DIR && bin/seguimiento >> /tmp/jarvis-seguimiento.log 2>&1
# Watchlist seguimiento — weekly flag scoring, Fri 6 PM
0 18 * * 5 cd $JARVIS_DIR && bin/seguimiento score >> /tmp/jarvis-seguimiento.log 2>&1
# Proactive reminders — every 30 min
*/30 * * * * cd $JARVIS_DIR && python3 bin/check-reminders >> /tmp/jarvis-reminders.log 2>&1
# Watchdog — every 5 min
*/5 * * * * cd $JARVIS_DIR && python3 bin/watchdog >> /tmp/jarvis-watchdog.log 2>&1"

# Remove old Jarvis block if present, then append new one
( crontab -l 2>/dev/null | grep -v "^$CRON_MARKER" | grep -v "jarvis" ; echo "$CRON_BLOCK" ) | crontab -
echo "  ✓ Crontab updated"

# ── 6. Tailscale serve routes ─────────────────────────────────────────
echo "[6/7] Configuring Tailscale serve routes..."

if command -v tailscale >/dev/null 2>&1; then
  CURRENT=$(tailscale serve status 2>/dev/null || true)
  add_route() {
    local path="$1" target="$2"
    if echo "$CURRENT" | grep -q "$target"; then
      echo "  ✓ /$(basename $path) already configured"
    else
      tailscale serve https "$path" "$target" 2>/dev/null && echo "  ✓ $path → $target" || echo "  ✗ failed: $path"
    fi
  }
  add_route /        http://127.0.0.1:8791
  add_route /chat    http://127.0.0.1:8792/chat
  add_route /voice   http://127.0.0.1:8792/voice
  add_route /events  http://127.0.0.1:8792/events
else
  echo "  Tailscale not found — add routes manually:"
  echo "    tailscale serve https / http://127.0.0.1:8791"
  echo "    tailscale serve https /chat http://127.0.0.1:8792/chat"
  echo "    tailscale serve https /voice http://127.0.0.1:8792/voice"
  echo "    tailscale serve https /events http://127.0.0.1:8792/events"
fi

# ── 7. verify ────────────────────────────────────────────────────────
echo "[7/7] Status check..."
echo ""
for svc in jarvis-bridge jarvis-telegram; do
  STATUS=$(systemctl is-active "$svc" 2>/dev/null || echo "unknown")
  ICON="✓" && [ "$STATUS" != "active" ] && ICON="✗"
  echo "  $ICON $svc: $STATUS"
done
echo ""
echo "  Crontab:"
crontab -l | grep -A20 "Jarvis" || echo "  (no Jarvis entries found)"
echo ""
echo "=== Instalación completa ==="
echo ""
echo "Logs en tiempo real:"
echo "  journalctl -u jarvis-telegram -f"
echo "  journalctl -u jarvis-bridge -f"
echo "  tail -f /tmp/jarvis-brief.log"
