# Claude Code local/personal settings (not shared project config)
.claude/settings.local.json
hud/.claude/

# Bridge secrets (token + phone session id) — generated automatically on first run
bridge/config.json

# Device registry (tailscale IPs + tokens of managed devices) — generated at runtime
bridge/devices.json

# Device agent token — generated automatically per device
agents/config.json

# Device agent local env (contains Pi IP and bridge token — never commit)
agents/.env

# Device agent shell-action audit log — commands executed on this device
agents/shell-audit.log

# Notification channel credentials (Discord webhook, Telegram token, Twilio keys)
bridge/.env

# Personal machine-specific symlink to voicemode's local event log
hud/voicemode-logs

# HUD token injected per device by bridge/server.py, + runtime state / uploads
hud/jarvis-config.js
bridge/watchdog_state.json
bridge/reminders_state.json
bridge/.claude-session.lock
bridge/hud_media/

# Personal vault content (habits, plans, reminders, notes) — keep the folders, not the data
vault/outputs/*
!vault/outputs/.gitkeep
vault/raw/*
!vault/raw/.gitkeep

# vault/wiki/ IS committed — it's the project knowledge graph (see vault/wiki/MOC.md).
# Personal / scratch notes go in vault/wiki/private/, which stays local.
vault/wiki/private/

# Obsidian workspace state (machine-specific paths/window layout)
vault/.obsidian/

# Misc
*.pyc
__pycache__/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
